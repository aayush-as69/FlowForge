# Postgres (shared by the Next.js health check and the Python backend)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Session signing key for the Python API. If unset, one is generated into backend/.secret_key
SECRET_KEY=
COOKIE_SECURE=0

# Password given to the seeded demo accounts (admin@/manager@/approver@/requester@/auditor@flowforge.demo)
DEMO_PASSWORD=flowforge-demo

# Optional: enable LLM-powered extraction & reviewer rationale (any OpenAI-compatible API).
# Without a key FlowForge falls back to its deterministic rule-based extractor.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Engine pacing for the live demo (seconds). Set to 0 for instant execution.
FF_STEP_DELAY=0.9
FF_RETRY_BACKOFF=0.8
FLOWFORGE_API_PORT=8000
