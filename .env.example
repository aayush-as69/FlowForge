# Local development database
DATABASE_URL=postgresql://flowforge:change-this-password@127.0.0.1:5432/flowforge
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=flowforge

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
APP_ENV=development
COOKIE_SECURE=0

# Demo seed is opt-in and only for local/demo use.
FF_SEED=1
DEMO_PASSWORD=replace-with-a-unique-demo-password

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
FF_STEP_DELAY=0.9
FF_RETRY_BACKOFF=0.8
FLOWFORGE_API_PORT=8000
API_METRIC_RETENTION_DAYS=90
